        <mxCell id="t2" value="&quot;백업은 받는 것이 아니라 복구되는 것이다&quot; — 모든 백업은 분기 1회 복원 훈련으로 유효성을 검증한다." style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#5F6368;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="56" width="1900" height="22" as="geometry"/></mxCell>
        <mxCell id="b1" value="① VM 백업  —  Compute Engine" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;strokeColor=#34A853;fillColor=#F2FBF5;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#34A853;spacingLeft=14;spacingTop=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="1020" height="290" as="geometry"/></mxCell>
