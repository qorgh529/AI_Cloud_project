        <mxCell id="pc_i2_l" value="IAP / OS Login" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1862.0" y="1346" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="pc_i3" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="2112.0" y="1300" width="36" height="42" as="geometry"/></mxCell>
        <mxCell id="pc_i3_l" value="Security Command Center" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2050.0" y="1346" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="pc_n" value="• &lt;b&gt;방화벽&lt;/b&gt;: Network Tag 기반 최소 허용, 마지막 규칙 &lt;b&gt;0.0.0.0/0 DENY&lt;/b&gt; (우선순위 65534)&lt;br/&gt;• &lt;b&gt;Cloud Armor&lt;/b&gt;: OWASP 사전구성 WAF(sqli/xss/lfi) · KR 외 차단 · Adaptive Protection&lt;br/&gt;• &lt;b&gt;IAM&lt;/b&gt;: 서버/네트워크/보안 담당 역할 분리, 사용자 MFA, VM은 전용 서비스 계정&lt;br/&gt;• &lt;b&gt;암호화&lt;/b&gt;: 전송 TLS 1.2+ · 저장 CMEK(Cloud KMS) · 비밀값 Secret Manager&lt;br/&gt;• &lt;b&gt;탐지&lt;/b&gt;: Security Command Center 취약점/구성오류, Cloud Audit Logs 불변 보관" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=4;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1540" y="1400" width="692" height="162" as="geometry"/></mxCell>
        <mxCell id="dr" value="⑨ 재해복구 (DR)  —  asia-northeast1 (Tokyo)  ·  목표 RTO ≤ 4시간 / RPO ≤ 15분  ·  Warm Standby(Pilot Light)" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;strokeColor=#FBBC04;fillColor=#FFFBF0;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#8A6D00;spacingLeft=14;spacingTop=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="1604" width="2200" height="180" as="geometry"/></mxCell>
