        <mxCell id="ex1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#8A6D00;strokeWidth=2;dashed=0;fontSize=11;fontColor=#8A6D00;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="x1" target="x2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#8A6D00;strokeWidth=2;dashed=0;fontSize=11;fontColor=#8A6D00;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="x2" target="x3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#8A6D00;strokeWidth=2;dashed=0;fontSize=11;fontColor=#8A6D00;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="x3" target="x4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#8A6D00;strokeWidth=2;dashed=0;fontSize=11;fontColor=#8A6D00;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="x4" target="x5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#8A6D00;strokeWidth=2;dashed=0;fontSize=11;fontColor=#8A6D00;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="x5" target="x6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex_al" value="실패 시" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#EA4335;strokeWidth=1;dashed=1;fontSize=11;fontColor=#EA4335;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="x2" target="x7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b3n" value="&lt;b&gt;GCS 수명주기 (Lifecycle) — 비용과 보관기간의 균형&lt;/b&gt;&amp;nbsp;&amp;nbsp;Standard &lt;span style=&quot;color:#5F6368&quot;&gt;(0~30일, 즉시 복구용)&lt;/span&gt; → &lt;b&gt;Nearline&lt;/b&gt; &lt;span style=&quot;color:#5F6368&quot;&gt;(30일~, 월 1회 접근)&lt;/span&gt; → &lt;b&gt;Coldline&lt;/b&gt; &lt;span style=&quot;color:#5F6368&quot;&gt;(90일~, 분기 1회)&lt;/span&gt; → &lt;b&gt;Archive&lt;/b&gt; &lt;span style=&quot;color:#5F6368&quot;&gt;(365일~, 법정 보관)&lt;/span&gt; → 2,555일(7년) 후 삭제&lt;br/&gt;&lt;b&gt;랜섬웨어·실수 삭제 대비&lt;/b&gt;: Object Versioning 활성화 + &lt;b&gt;Bucket Lock(보존 정책)&lt;/b&gt; 으로 관리자조차 보존기간 내 삭제 불가하게 설정. 백업 버킷은 &lt;b&gt;별도 서비스 계정&lt;/b&gt;만 쓰기 가능하고, 운영 VM의 서비스 계정에는 &lt;code&gt;objectCreator&lt;/code&gt; 만 부여해 기존 백업 덮어쓰기를 차단한다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=4;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="600" width="2040" height="100" as="geometry"/></mxCell>
        <mxCell id="b4" value="④ 재해복구 (DR)  —  asia-northeast1 (Tokyo)  ·  Warm Standby / Pilot Light" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;strokeColor=#EA4335;fillColor=#FEF4F3;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#EA4335;spacingLeft=14;spacingTop=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="750" width="1380" height="380" as="geometry"/></mxCell>
        <mxCell id="r0" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="164.0" y="810" width="32" height="42" as="geometry"/></mxCell>
