        <mxCell id="o_tbl" value="&lt;b&gt;주요 알림 정책 (Alerting Policy)&lt;/b&gt;&lt;table style=&quot;font-size:10.5px;border-collapse:collapse;width:100%;margin-top:4px&quot;&gt;&lt;tr style=&quot;background:#F1F3F4&quot;&gt;&lt;th align=&quot;left&quot;&gt;지표&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;임계&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;등급&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LB 5xx 비율&lt;/td&gt;&lt;td&gt;&amp;gt; 1% (5분)&lt;/td&gt;&lt;td&gt;Sev1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Uptime Check 실패&lt;/td&gt;&lt;td&gt;2회 연속&lt;/td&gt;&lt;td&gt;Sev1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MIG 정상 인스턴스&lt;/td&gt;&lt;td&gt;&amp;lt; 2대&lt;/td&gt;&lt;td&gt;Sev1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Cloud SQL CPU&lt;/td&gt;&lt;td&gt;&amp;gt; 80% (10분)&lt;/td&gt;&lt;td&gt;Sev2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;복제 지연 (replica lag)&lt;/td&gt;&lt;td&gt;&amp;gt; 60초&lt;/td&gt;&lt;td&gt;Sev2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;VM 메모리 / 디스크&lt;/td&gt;&lt;td&gt;&amp;gt; 85%&lt;/td&gt;&lt;td&gt;Sev2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Tomcat JVM Old Gen&lt;/td&gt;&lt;td&gt;&amp;gt; 85%&lt;/td&gt;&lt;td&gt;Sev2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;스냅샷 / 백업 Job 실패&lt;/td&gt;&lt;td&gt;1회&lt;/td&gt;&lt;td&gt;Sev2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Cloud Armor 차단 급증&lt;/td&gt;&lt;td&gt;기준선 5배&lt;/td&gt;&lt;td&gt;Sev3&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=4;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1140" y="255" width="460" height="285" as="geometry"/></mxCell>
