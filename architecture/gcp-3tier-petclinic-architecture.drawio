        <mxCell id="t1" value="GCP 3-Tier Architecture — Spring PetClinic" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#202124;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="18" width="1800" height="34" as="geometry"/></mxCell>
        <mxCell id="t2" value="Team NOVA (GCP 1팀)  ·  Region: asia-northeast3 (Seoul)  ·  WEB: Apache 2.4  |  WAS: Tomcat 9 + OpenJDK 17  |  DB: Cloud SQL for MySQL 8.0" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#5F6368;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="54" width="1900" height="22" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;b&gt;Service Flow&lt;/b&gt;&amp;nbsp; User → Cloud DNS → Cloud Armor → External HTTPS LB (+Cloud CDN) → &lt;b&gt;WEB&lt;/b&gt; Apache 2.4 (mod_proxy) → Internal Application LB → &lt;b&gt;WAS&lt;/b&gt; Tomcat + PetClinic → &lt;b&gt;DB&lt;/b&gt; Cloud SQL MySQL (Private IP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;align=left;verticalAlign=top;fontSize=13;spacingLeft=10;spacingTop=4;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="82" width="2200" height="30" as="geometry"/></mxCell>
