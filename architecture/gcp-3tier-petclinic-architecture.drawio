        <mxCell id="pc_i0_l" value="VPC Firewall" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1522.0" y="1346" width="160" height="40" as="geometry"/></mxCell>
