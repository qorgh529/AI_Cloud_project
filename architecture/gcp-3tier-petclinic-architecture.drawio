        <mxCell id="ed0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#4285F4;strokeWidth=2;dashed=0;fontSize=11;fontColor=#4285F4;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d0" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#4285F4;strokeWidth=2;dashed=0;fontSize=11;fontColor=#4285F4;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#4285F4;strokeWidth=2;dashed=0;fontSize=11;fontColor=#4285F4;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b2n" value="&lt;b&gt;왜 자동 백업만으로 부족한가&lt;/b&gt; — Cloud SQL 자동 백업은 &lt;b&gt;인스턴스에 종속&lt;/b&gt;된다. 인스턴스가 삭제되면 백업도 함께 사라지고, 다른 프로젝트·리전·온프레미스로 옮길 수 없다.&lt;br/&gt;따라서 요구사항의 &lt;b&gt;&quot;별도 파일로 최종 보관&quot;&lt;/b&gt; 을 만족하려면 아래 ③ Export 파이프라인이 반드시 필요하다.&lt;br/&gt;&lt;b&gt;운영 주의&lt;/b&gt;: Export 는 인스턴스에 부하를 준다 → &lt;b&gt;Read Replica 대상&lt;/b&gt;으로 수행하고 사용량이 가장 적은 새벽 시간대에 실행한다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=4;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1130" y="268" width="980" height="108" as="geometry"/></mxCell>
        <mxCell id="b3" value="③ 파일 백업 파이프라인  —  &quot;매일 사용량이 적은 시간대에 실행, 별도 파일로 최종 보관&quot; 요구사항 충족" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;strokeColor=#FBBC04;fillColor=#FFFBF0;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#8A6D00;spacingLeft=14;spacingTop=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="420" width="2080" height="300" as="geometry"/></mxCell>
