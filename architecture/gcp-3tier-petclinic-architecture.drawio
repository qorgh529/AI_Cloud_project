        <mxCell id="v1" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="382.5" y="160" width="35" height="44" as="geometry"/></mxCell>
        <mxCell id="v1_l" value="Snapshot Schedule&#10;매일 03:00 KST · 증분" style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="285.0" y="208" width="230" height="40" as="geometry"/></mxCell>
