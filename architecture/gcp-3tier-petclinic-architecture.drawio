        <mxCell id="v2_l" value="스냅샷 저장소&#10;(멀티리전 · 자동 관리)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="535.0" y="208" width="230" height="40" as="geometry"/></mxCell>
