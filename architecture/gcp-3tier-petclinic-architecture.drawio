        <mxCell id="r2" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="659.0" y="810" width="42" height="42" as="geometry"/></mxCell>
        <mxCell id="r2_l" value="Pilot-light MIG&#10;(target size 0)" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="570.0" y="856" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="r3" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="909.0" y="810" width="42" height="42" as="geometry"/></mxCell>
        <mxCell id="r3_l" value="LB / 방화벽&#10;사전 생성" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="820.0" y="856" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="r4" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1209.0" y="810" width="42" height="42" as="geometry"/></mxCell>
        <mxCell id="r4_l" value="Cloud DNS&#10;평시 TTL 300s" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1120.0" y="856" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="b4n" value="&lt;b&gt;DR 전환 절차 (목표 RTO 4시간 이내)&lt;/b&gt;&lt;br/&gt;① &lt;b&gt;장애 인지&lt;/b&gt; — Uptime Check 연속 실패 + 리전 상태 대시보드 확인 (0~10분)&lt;br/&gt;② &lt;b&gt;전환 의사결정&lt;/b&gt; — 사전 정의된 판단 기준(리전 장애 30분 이상 지속)에 따라 선언 (10~20분)&lt;br/&gt;③ &lt;b&gt;DB 승격&lt;/b&gt; — Tokyo Read Replica 를 독립 Primary 로 &lt;b&gt;Promote&lt;/b&gt; (20~40분)&lt;br/&gt;④ &lt;b&gt;애플리케이션 기동&lt;/b&gt; — Pilot-light MIG 크기를 0 → 2 로 조정, 골든 이미지로 자동 부팅 (40~70분)&lt;br/&gt;⑤ &lt;b&gt;DNS 전환&lt;/b&gt; — A 레코드를 Tokyo LB IP 로 변경, TTL 을 30초로 하향 (70~90분)&lt;br/&gt;⑥ &lt;b&gt;검증&lt;/b&gt; — PetClinic 로그인·조회·등록 기능 및 DB 쓰기 확인 후 서비스 재개 선언 (~120분)&lt;br/&gt;&lt;b&gt;사전 준비가 RTO 를 결정한다&lt;/b&gt; — VPC·서브넷·방화벽·LB·Instance Template 을 평시에 Terraform 으로 &lt;b&gt;미리 생성&lt;/b&gt;해 두면, 장애 시에는 &quot;크기 조정 + DNS 변경&quot;만 남는다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=4;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="930" width="1340" height="185" as="geometry"/></mxCell>
        <mxCell id="rpo" value="&lt;b style=&quot;font-size:13px&quot;&gt;복구 목표 (RPO / RTO) 정의&lt;/b&gt;&lt;table style=&quot;font-size:11px;border-collapse:collapse;width:100%;margin-top:6px&quot;&gt;&lt;tr style=&quot;background:#F1F3F4&quot;&gt;&lt;th align=&quot;left&quot;&gt;장애 시나리오&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;RPO&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;RTO&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;복구 수단&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;VM 1대 장애&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;~3분&lt;/td&gt;&lt;td&gt;MIG 자동 복구 + LB 제외&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Zone 장애&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;~5분&lt;/td&gt;&lt;td&gt;Regional MIG + Cloud SQL HA Failover&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;애플리케이션 배포 실패&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;~10분&lt;/td&gt;&lt;td&gt;MIG 롤링 &lt;b&gt;Rollback&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DB 논리적 손상&lt;br/&gt;(잘못된 UPDATE/DELETE)&lt;/td&gt;&lt;td&gt;~1분&lt;/td&gt;&lt;td&gt;~1시간&lt;/td&gt;&lt;td&gt;Cloud SQL &lt;b&gt;PITR&lt;/b&gt; (시점 복구)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DB 인스턴스 삭제&lt;/td&gt;&lt;td&gt;~24시간&lt;/td&gt;&lt;td&gt;~2시간&lt;/td&gt;&lt;td&gt;GCS Export 파일 → 신규 인스턴스 Import&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;OS/디스크 손상&lt;/td&gt;&lt;td&gt;~24시간&lt;/td&gt;&lt;td&gt;~30분&lt;/td&gt;&lt;td&gt;PD 스냅샷 복원&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;리전 전체 장애&lt;/b&gt;&lt;/td&gt;&lt;td&gt;~15분&lt;/td&gt;&lt;td&gt;&lt;b&gt;~4시간&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Tokyo Replica 승격 + Pilot-light + DNS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;랜섬웨어 / 내부자 삭제&lt;/td&gt;&lt;td&gt;~24시간&lt;/td&gt;&lt;td&gt;~4시간&lt;/td&gt;&lt;td&gt;Versioning + Bucket Lock 백업 복원&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br/&gt;&lt;b&gt;검증 계획&lt;/b&gt; — 분기 1회 DR 훈련일을 지정해 ③~⑥ 절차를 실제 수행하고, 측정된 RTO 를 기록해 목표와의 차이를 개선한다. &lt;b&gt;훈련하지 않은 DR 은 DR 이 아니다.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=4;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1470" y="750" width="660" height="380" as="geometry"/></mxCell>
        <mxCell id="warn" value="&lt;b style=&quot;font-size:13px;color:#EA4335&quot;&gt;⚠ 흔한 실수 (Anti-pattern) — 발표 질의응답 대비&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;&quot;HA 구성했으니 백업은 필요 없다&quot;&lt;/b&gt; → HA 는 &lt;b&gt;인프라 장애&lt;/b&gt; 대비이고 백업은 &lt;b&gt;데이터 손상·실수·랜섬웨어&lt;/b&gt; 대비다. 잘못된 DELETE 는 Standby 에도 즉시 복제된다.&lt;br/&gt;• &lt;b&gt;&quot;스냅샷을 받았으니 안전하다&quot;&lt;/b&gt; → 스냅샷은 같은 프로젝트에 있다. 프로젝트 자체가 삭제되면 함께 사라지므로, 별도 버킷(+Bucket Lock)으로의 &lt;b&gt;파일 반출&lt;/b&gt;이 최종 방어선이다.&lt;br/&gt;• &lt;b&gt;&quot;복구 테스트는 나중에&quot;&lt;/b&gt; → 백업 파일 손상·권한 누락·스키마 불일치는 실제 복구를 시도해야만 드러난다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF4F3;strokeColor=#EA4335;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=4;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="1160" width="2080" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="④ 보안 · 네트워크 상세" id="④ 보안 · 네트워크 상세">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2180" pageHeight="1210" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="보안 · 네트워크 상세 설계  (Defense in Depth)" style="text;html=1;whiteSpace=wrap;fontSize=23;fontStyle=1;fontColor=#202124;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1600" height="32" as="geometry"/></mxCell>
        <mxCell id="t2" value="경계(Cloud Armor) → 네트워크(VPC/방화벽) → 신원(IAM/IAP) → 데이터(KMS/Secret Manager) → 탐지(SCC/Audit Log)" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#5F6368;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="56" width="1900" height="22" as="geometry"/></mxCell>
        <mxCell id="L1" value="① 경계 보안 (Edge)" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;strokeColor=#EA4335;fillColor=#FEF4F3;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#EA4335;spacingLeft=14;spacingTop=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="400" height="420" as="geometry"/></mxCell>
        <mxCell id="L1_i0" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="133.0" y="148" width="34" height="40" as="geometry"/></mxCell>
        <mxCell id="L1_i0_l" value="Cloud Armor" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="65.0" y="192" width="170" height="40" as="geometry"/></mxCell>
        <mxCell id="L1_i1" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="320.0" y="148" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="L1_i1_l" value="Cloud CDN" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="255.0" y="192" width="170" height="40" as="geometry"/></mxCell>
        <mxCell id="L1_n" value="• &lt;b&gt;Geo 제한&lt;/b&gt;: &lt;code&gt;origin.region_code == &quot;KR&quot;&lt;/code&gt; 외 전부 403 차단&lt;br/&gt;&amp;nbsp;&amp;nbsp;(한국 전용 서비스 요구사항 반영)&lt;br/&gt;• &lt;b&gt;WAF&lt;/b&gt;: 사전 구성 규칙 &lt;code&gt;sqli-v33&lt;/code&gt;, &lt;code&gt;xss-v33&lt;/code&gt;,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;lfi-v33&lt;/code&gt;, &lt;code&gt;rce-v33&lt;/code&gt; — 민감도 단계적 상향&lt;br/&gt;• &lt;b&gt;L3/L4 DDoS&lt;/b&gt;: Global LB 사용 시 기본 제공(SYN/ICMP flood)&lt;br/&gt;• &lt;b&gt;L7 DDoS&lt;/b&gt;: Adaptive Protection 으로 이상 트래픽 학습·제안&lt;br/&gt;• &lt;b&gt;Rate Limit&lt;/b&gt;: IP당 100 req/min 초과 시 429&lt;br/&gt;• &lt;b&gt;SSL&lt;/b&gt;: Google-managed 인증서, LB 에서 SSL Offload,&lt;br/&gt;&amp;nbsp;&amp;nbsp;TLS 1.2+ 정책, HTTP→HTTPS 301 리다이렉트" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;verticalAlign=top;fontSize=10.5;spacingLeft=10;spacingTop=4;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="66" y="244" width="368" height="262" as="geometry"/></mxCell>
        <mxCell id="L2" value="② 네트워크 보안" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;strokeColor=#34A853;fillColor=#F2FBF5;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#34A853;spacingLeft=14;spacingTop=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="420" height="420" as="geometry"/></mxCell>
        <mxCell id="L2_i0" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="560.0" y="148" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="L2_i0_l" value="VPC Firewall" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="495.0" y="192" width="170" height="40" as="geometry"/></mxCell>
        <mxCell id="L2_i1" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="770.0" y="148" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="L2_i1_l" value="Cloud NAT" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="705.0" y="192" width="170" height="40" as="geometry"/></mxCell>
        <mxCell id="L2_n" value="• &lt;b&gt;Custom Mode VPC&lt;/b&gt; — 기본 VPC 미사용, 서브넷 수동 설계&lt;br/&gt;• &lt;b&gt;Network Tag 기반&lt;/b&gt; 규칙 (IP 하드코딩 최소화)&lt;br/&gt;• &lt;b&gt;공인 IP 0개&lt;/b&gt; — 모든 VM External IP 미할당&lt;br/&gt;• &lt;b&gt;Cloud NAT&lt;/b&gt; — 아웃바운드 전용(인바운드 불가),&lt;br/&gt;&amp;nbsp;&amp;nbsp;패치·apt 업데이트 경로. 로깅 활성화&lt;br/&gt;• &lt;b&gt;Private Google Access&lt;/b&gt; — GCS/Secret Manager 를&lt;br/&gt;&amp;nbsp;&amp;nbsp;인터넷 경유 없이 내부 경로로 호출&lt;br/&gt;• &lt;b&gt;Private Service Access&lt;/b&gt; — Cloud SQL 비공개 IP&lt;br/&gt;&amp;nbsp;&amp;nbsp;(VPC Peering, Public IP 완전 미할당)&lt;br/&gt;• &lt;b&gt;Flow Logs&lt;/b&gt; — 서브넷별 활성화(샘플링 0.5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;verticalAlign=top;fontSize=10.5;spacingLeft=10;spacingTop=4;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="496" y="244" width="388" height="262" as="geometry"/></mxCell>
        <mxCell id="L3" value="③ 신원 · 접근 제어" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;strokeColor=#4285F4;fillColor=#F5F9FF;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#4285F4;spacingLeft=14;spacingTop=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="930" y="100" width="420" height="420" as="geometry"/></mxCell>
        <mxCell id="L3_i0" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1014.0" y="148" width="32" height="40" as="geometry"/></mxCell>
        <mxCell id="L3_i0_l" value="Cloud IAM" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="945.0" y="192" width="170" height="40" as="geometry"/></mxCell>
        <mxCell id="L3_i1" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1221.0" y="148" width="38" height="40" as="geometry"/></mxCell>
        <mxCell id="L3_i1_l" value="IAP / OS Login" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1155.0" y="192" width="170" height="40" as="geometry"/></mxCell>
        <mxCell id="L3_n" value="• &lt;b&gt;IAM 역할 분리&lt;/b&gt; (요구사항 반영)&lt;br/&gt;&amp;nbsp;&amp;nbsp;- 서버 담당: &lt;code&gt;compute.instanceAdmin&lt;/code&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;- 네트워크: &lt;code&gt;compute.networkAdmin&lt;/code&gt; +&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;code&gt;compute.loadBalancerAdmin&lt;/code&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;- 보안: &lt;code&gt;compute.securityAdmin&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;기본 서비스 계정 미사용&lt;/b&gt; — VM별 전용 SA에&lt;br/&gt;&amp;nbsp;&amp;nbsp;필요 권한만 부여 (secretAccessor, objectViewer)&lt;br/&gt;• &lt;b&gt;IAP TCP Forwarding&lt;/b&gt; — SSH 22 를 인터넷에&lt;br/&gt;&amp;nbsp;&amp;nbsp;열지 않고 &lt;code&gt;35.235.240.0/20&lt;/code&gt; 만 허용&lt;br/&gt;• &lt;b&gt;OS Login + 2단계 인증(MFA)&lt;/b&gt; 강제&lt;br/&gt;• &lt;b&gt;Bastion&lt;/b&gt; — 회사/승인 IP 만 접속, 별도 포트" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;verticalAlign=top;fontSize=10.5;spacingLeft=10;spacingTop=4;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="946" y="244" width="388" height="262" as="geometry"/></mxCell>
        <mxCell id="L4" value="④ 데이터 보호" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;strokeColor=#FBBC04;fillColor=#FFFBF0;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#FBBC04;spacingLeft=14;spacingTop=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1380" y="100" width="380" height="420" as="geometry"/></mxCell>
        <mxCell id="L4_i0" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1454.0" y="148" width="32" height="40" as="geometry"/></mxCell>
        <mxCell id="L4_i0_l" value="Cloud KMS" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1385.0" y="192" width="170" height="40" as="geometry"/></mxCell>
        <mxCell id="L4_i1" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1653.5" y="148" width="33" height="40" as="geometry"/></mxCell>
        <mxCell id="L4_i1_l" value="Secret Manager" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1585.0" y="192" width="170" height="40" as="geometry"/></mxCell>
        <mxCell id="L4_n" value="• &lt;b&gt;전송 중 암호화&lt;/b&gt; — 외부 TLS 1.2+,&lt;br/&gt;&amp;nbsp;&amp;nbsp;내부 VPC 구간도 Google 기본 암호화&lt;br/&gt;• &lt;b&gt;저장 데이터 암호화&lt;/b&gt; — CMEK 적용&lt;br/&gt;&amp;nbsp;&amp;nbsp;(Persistent Disk · GCS · Cloud SQL)&lt;br/&gt;• &lt;b&gt;키 순환&lt;/b&gt; 90일 자동, 키 삭제 보호&lt;br/&gt;• &lt;b&gt;Secret Manager&lt;/b&gt; — DB 비밀번호를&lt;br/&gt;&amp;nbsp;&amp;nbsp;startup-script/코드/이미지에 평문 저장 금지&lt;br/&gt;&amp;nbsp;&amp;nbsp;VM 부팅 시 SA 권한으로 런타임 조회&lt;br/&gt;• &lt;b&gt;버전 관리&lt;/b&gt; — 비밀 교체 시 무중단 롤아웃" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;verticalAlign=top;fontSize=10.5;spacingLeft=10;spacingTop=4;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1396" y="244" width="348" height="262" as="geometry"/></mxCell>
        <mxCell id="L5" value="⑤ 탐지 · 감사" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;strokeColor=#5F6368;fillColor=#F8F9FA;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#5F6368;spacingLeft=14;spacingTop=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1790" y="100" width="340" height="420" as="geometry"/></mxCell>
        <mxCell id="L5_i0" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1863.0" y="148" width="34" height="40" as="geometry"/></mxCell>
        <mxCell id="L5_i0_l" value="SCC" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1795.0" y="192" width="170" height="40" as="geometry"/></mxCell>
        <mxCell id="L5_i1" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="2023.5" y="148" width="53" height="40" as="geometry"/></mxCell>
        <mxCell id="L5_i1_l" value="DLP" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1965.0" y="192" width="170" height="40" as="geometry"/></mxCell>
        <mxCell id="L5_n" value="• &lt;b&gt;Security Command Center&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;구성 오류 · 취약점 · 공개 리소스 탐지&lt;br/&gt;• &lt;b&gt;Cloud Audit Logs&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Admin Activity 는 기본 활성 · 삭제 불가&lt;br/&gt;&amp;nbsp;&amp;nbsp;Data Access 로그 선택 활성화&lt;br/&gt;• &lt;b&gt;Org Policy&lt;/b&gt; — 공인 IP 생성 금지,&lt;br/&gt;&amp;nbsp;&amp;nbsp;SA 키 생성 금지, 특정 리전만 허용&lt;br/&gt;• &lt;b&gt;DLP&lt;/b&gt; — 로그/백업 내 개인정보 스캔&lt;br/&gt;• &lt;b&gt;Cloud Security Scanner&lt;/b&gt; — 웹 취약점 점검" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;verticalAlign=top;fontSize=10.5;spacingLeft=10;spacingTop=4;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1806" y="244" width="308" height="262" as="geometry"/></mxCell>
        <mxCell id="fw" value="&lt;b style=&quot;font-size:14px&quot;&gt;VPC 방화벽 규칙 설계 (최소 권한 · Network Tag 기반)&lt;/b&gt;&lt;table style=&quot;font-size:11px;border-collapse:collapse;width:100%;margin-top:8px&quot;&gt;&lt;tr style=&quot;background:#F1F3F4&quot;&gt;&lt;th align=&quot;left&quot;&gt;우선순위&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;규칙명&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;소스&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;대상 태그&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;프로토콜/포트&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;동작&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;목적&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;100&lt;/td&gt;&lt;td&gt;allow-lb-to-web&lt;/td&gt;&lt;td&gt;130.211.0.0/22&lt;br/&gt;35.191.0.0/16&lt;/td&gt;&lt;td&gt;web&lt;/td&gt;&lt;td&gt;tcp:80&lt;/td&gt;&lt;td style=&quot;color:#34A853&quot;&gt;&lt;b&gt;허용&lt;/b&gt;&lt;/td&gt;&lt;td&gt;External LB → WEB (+헬스체크)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FAFAFA&quot;&gt;&lt;td&gt;110&lt;/td&gt;&lt;td&gt;allow-web-to-was&lt;/td&gt;&lt;td&gt;tag: &lt;b&gt;web&lt;/b&gt;&lt;br/&gt;130.211.0.0/22, 35.191.0.0/16&lt;/td&gt;&lt;td&gt;was&lt;/td&gt;&lt;td&gt;tcp:8080&lt;/td&gt;&lt;td style=&quot;color:#34A853&quot;&gt;&lt;b&gt;허용&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Internal LB → WAS (+헬스체크)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;120&lt;/td&gt;&lt;td&gt;allow-was-to-sql&lt;/td&gt;&lt;td&gt;tag: &lt;b&gt;was&lt;/b&gt;&lt;/td&gt;&lt;td&gt;(PSA 대역)&lt;/td&gt;&lt;td&gt;tcp:3306&lt;/td&gt;&lt;td style=&quot;color:#34A853&quot;&gt;&lt;b&gt;허용&lt;/b&gt;&lt;/td&gt;&lt;td&gt;WAS → Cloud SQL (JDBC)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FAFAFA&quot;&gt;&lt;td&gt;130&lt;/td&gt;&lt;td&gt;allow-was-to-redis&lt;/td&gt;&lt;td&gt;tag: &lt;b&gt;was&lt;/b&gt;&lt;/td&gt;&lt;td&gt;(Memorystore)&lt;/td&gt;&lt;td&gt;tcp:6379&lt;/td&gt;&lt;td style=&quot;color:#34A853&quot;&gt;&lt;b&gt;허용&lt;/b&gt;&lt;/td&gt;&lt;td&gt;WAS → Redis 세션&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;200&lt;/td&gt;&lt;td&gt;allow-iap-ssh&lt;/td&gt;&lt;td&gt;&lt;b&gt;35.235.240.0/20&lt;/b&gt;&lt;/td&gt;&lt;td&gt;web, was, bastion&lt;/td&gt;&lt;td&gt;tcp:22&lt;/td&gt;&lt;td style=&quot;color:#34A853&quot;&gt;&lt;b&gt;허용&lt;/b&gt;&lt;/td&gt;&lt;td&gt;IAP TCP Forwarding 관리 접속&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FAFAFA&quot;&gt;&lt;td&gt;300&lt;/td&gt;&lt;td&gt;allow-bastion-ssh&lt;/td&gt;&lt;td&gt;tag: &lt;b&gt;bastion&lt;/b&gt;&lt;/td&gt;&lt;td&gt;web, was&lt;/td&gt;&lt;td&gt;tcp:22&lt;/td&gt;&lt;td style=&quot;color:#34A853&quot;&gt;&lt;b&gt;허용&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bastion → 내부 서버&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1000&lt;/td&gt;&lt;td&gt;allow-onprem-vpn&lt;/td&gt;&lt;td&gt;192.168.0.0/16&lt;/td&gt;&lt;td&gt;was&lt;/td&gt;&lt;td&gt;tcp:3306&lt;/td&gt;&lt;td style=&quot;color:#34A853&quot;&gt;&lt;b&gt;허용&lt;/b&gt;&lt;/td&gt;&lt;td&gt;온프레미스 MySQL 복제 (HA VPN)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FEF4F3&quot;&gt;&lt;td&gt;&lt;b&gt;65534&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;deny-all-ingress&lt;/b&gt;&lt;/td&gt;&lt;td&gt;0.0.0.0/0&lt;/td&gt;&lt;td&gt;(전체)&lt;/td&gt;&lt;td&gt;all&lt;/td&gt;&lt;td style=&quot;color:#EA4335&quot;&gt;&lt;b&gt;거부&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;명시 허용 외 모든 인바운드 차단&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br/&gt;※ &lt;b&gt;Tag 기반 설계 이유&lt;/b&gt; — IP 대역을 직접 쓰면 서브넷 변경·오토스케일 시 규칙을 매번 수정해야 한다. Network Tag(또는 Service Account)를 대상으로 삼으면 &lt;b&gt;인스턴스가 늘어나도 규칙은 그대로&lt;/b&gt; 유지된다.&lt;br/&gt;※ GCP 방화벽은 &lt;b&gt;상태 저장(stateful)&lt;/b&gt; 이므로 응답 트래픽을 위한 아웃바운드 규칙은 별도로 필요하지 않다. 아웃바운드는 기본 허용이며, 필요 시 Egress 규칙으로 추가 제한한다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=4;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="552" width="1290" height="356" as="geometry"/></mxCell>
        <mxCell id="ap" value="관리자 접근 경로 (Zero Trust)" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;strokeColor=#4285F4;fillColor=#F5F9FF;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#4285F4;spacingLeft=14;spacingTop=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1380" y="552" width="750" height="356" as="geometry"/></mxCell>
        <mxCell id="ap0" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1460.0" y="604" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="ap0_l" value="관리자&#10;(회사 / 승인 재택 IP)" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1360.0" y="648" width="240" height="40" as="geometry"/></mxCell>
        <mxCell id="ap1" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1674.0" y="604" width="32" height="40" as="geometry"/></mxCell>
        <mxCell id="ap1_l" value="Google 계정&#10;+ MFA (2단계)" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1570.0" y="648" width="240" height="40" as="geometry"/></mxCell>
        <mxCell id="ap2" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1911.0" y="604" width="38" height="40" as="geometry"/></mxCell>
        <mxCell id="ap2_l" value="IAP TCP Forwarding&#10;gcloud compute ssh --tunnel" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1810.0" y="648" width="240" height="40" as="geometry"/></mxCell>
        <mxCell id="ap3" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1570.0" y="724" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="ap3_l" value="Bastion (mgmt-subnet)&#10;OS Login · 세션 로깅" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1470.0" y="768" width="240" height="40" as="geometry"/></mxCell>
        <mxCell id="ap4" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1880.0" y="724" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="ap4_l" value="WEB / WAS VM&#10;(공인 IP 없음)" style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#202124;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1780.0" y="768" width="240" height="40" as="geometry"/></mxCell>
        <mxCell id="ea0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#4285F4;strokeWidth=2;dashed=0;fontSize=11;fontColor=#4285F4;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ap0" target="ap1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea1" value="인증/인가" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#4285F4;strokeWidth=2;dashed=0;fontSize=11;fontColor=#4285F4;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ap1" target="ap2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea2" value=":22 터널" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#4285F4;strokeWidth=2;dashed=0;fontSize=11;fontColor=#4285F4;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ap2" target="ap3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#4285F4;strokeWidth=2;dashed=0;fontSize=11;fontColor=#4285F4;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ap3" target="ap4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="apn" value="&lt;b&gt;IAP 를 쓰는 이유&lt;/b&gt; — Bastion 에 공인 IP + 22 포트를 열면 전 세계 스캐너의 무차별 대입 공격 대상이 된다. IAP 는 Google 인증을 통과한 사용자에게만 터널을 열어주므로 &lt;b&gt;공인 IP 자체가 불필요&lt;/b&gt;하고, 모든 접속이 Audit Log 에 남아 추적 가능하다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=4;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1398" y="818" width="714" height="78" as="geometry"/></mxCell>
        <mxCell id="res" value="&lt;b style=&quot;font-size:13px&quot;&gt;기술 의사결정 요약 (발표 Q&amp;amp;A 대비)&lt;/b&gt;&lt;table style=&quot;font-size:11px;border-collapse:collapse;width:100%;margin-top:6px&quot;&gt;&lt;tr style=&quot;background:#F1F3F4&quot;&gt;&lt;th align=&quot;left&quot;&gt;쟁점&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;선택&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;근거&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;WEB–WAS 연동&lt;/td&gt;&lt;td&gt;&lt;b&gt;mod_proxy (HTTP)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;AJP 는 Tomcat 9 에서 기본 비활성 + Ghostcat(CVE-2020-1938) 이력. mod_jk 는 별도 커넥터 설치·설정 필요. HTTP 는 Internal &lt;b&gt;L7&lt;/b&gt; LB 와 그대로 호환된다.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FAFAFA&quot;&gt;&lt;td&gt;Internal LB 종류&lt;/td&gt;&lt;td&gt;&lt;b&gt;Internal Application LB (L7)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;URL 기반 라우팅과 &lt;b&gt;HTTP 응답 본문 헬스체크&lt;/b&gt;가 가능하다. L4 Network LB 는 TCP 포트 생존만 확인하므로 &quot;프로세스는 살아있고 앱은 죽은&quot; 상태를 걸러내지 못한다.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;세션 관리&lt;/td&gt;&lt;td&gt;&lt;b&gt;Stateless + Redis&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Sticky Session 은 특정 WAS 에 부하가 쏠리고, 오토스케일 축소 시 세션이 유실된다. Tomcat 기본 세션 클러스터링은 &lt;b&gt;멀티캐스트&lt;/b&gt; 기반인데 GCP VPC 는 유니캐스트만 지원한다.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FAFAFA&quot;&gt;&lt;td&gt;WEB/WAS 이중화&lt;/td&gt;&lt;td&gt;&lt;b&gt;Regional MIG&lt;/b&gt;&lt;/td&gt;&lt;td&gt;개별 VM 은 장애 시 수동 복구가 필요하다. Regional MIG 는 3개 Zone 분산 + 자동 복구 + 오토스케일 + 롤링 업데이트/롤백을 모두 제공한다.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DB 접근&lt;/td&gt;&lt;td&gt;&lt;b&gt;Private IP 전용&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Public IP 를 부여하면 승인 네트워크 설정 실수 한 번으로 DB 가 인터넷에 노출된다. Private Service Access 는 공인 IP 자체를 만들지 않는다.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FAFAFA&quot;&gt;&lt;td&gt;SSL 종료 위치&lt;/td&gt;&lt;td&gt;&lt;b&gt;External LB&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Google-managed 인증서로 갱신이 자동화되고, 백엔드 VM 의 CPU 부담(SSL 연산)이 줄며, 인증서를 VM 이미지에 넣지 않아도 되어 관리 지점이 하나로 모인다.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=4;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="936" width="2080" height="250" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
